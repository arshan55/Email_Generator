{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "templates/**",
        "static/**",
        "main.py",
        "requirements.txt"
      ]
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index" }
  ]
} 